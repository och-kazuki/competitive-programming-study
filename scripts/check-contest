#!/usr/bin/env bash
# 問題一覧と oj を偽物に差し替え、ネットなしでコンテスト準備を確認する。
set -euo pipefail

# shellcheck disable=SC1091
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/require-dev-shell"

if [[ -z "${CP_PROJECT_ROOT:-}" ]]; then
  CP_PROJECT_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
fi

work=$(mktemp -d)
trap 'rm -rf "$work" "$CP_PROJECT_ROOT/work/abc999" "$CP_PROJECT_ROOT/work/abc998" "$CP_PROJECT_ROOT/work/abc997" "$CP_PROJECT_ROOT/work/abc996" "$CP_PROJECT_ROOT/work/abc995" "$CP_PROJECT_ROOT/work/arc190"' EXIT

fetch="$work/fetch"
oj="$work/oj"
fetch_log="$work/fetch.log"
oj_log="$work/oj.log"
cat >"$fetch" <<'EOF'
#!/bin/sh
printf '%s\n' "$1" >> "$CP_FETCH_LOG"
printf '%s %s\n' a "https://atcoder.jp/contests/$1/tasks/${1}_a"
printf '%s %s\n' b "https://atcoder.jp/contests/$1/tasks/${1}_b"
printf '%s %s\n' ex "https://atcoder.jp/contests/$1/tasks/${1}_h"
EOF
cat >"$oj" <<'EOF'
#!/bin/sh
# 本物の oj と同じく、ログは標準出力に出す。
echo "[INFO] online-judge-tools fake"
echo "[INFO] download $1"
printf '%s\n' "$1" >> "$CP_OJ_LOG"
mkdir -p "$2/test"
printf '2 3\n' > "$2/test/sample-1.in"
printf '5\n' > "$2/test/sample-1.out"
echo "[SUCCESS] saved to: test/sample-1.in"
EOF
fail_fetch="$work/fail-fetch"
cat >"$fail_fetch" <<'EOF'
#!/bin/sh
printf '%s\n' "$1" >> "$CP_FETCH_LOG"
echo "simulated failure" >&2
exit 1
EOF
chmod +x "$fetch" "$oj" "$fail_fetch"

# PATH 上の curl / wget / python / oj は即失敗させる。
# 後ろに本物が見えていても、先にこちらのスタブが選ばれる。
net_block="$work/net-block"
net_behind="$work/net-behind"
mkdir -p "$net_block" "$net_behind"
export CP_NET_DENY_LOG="$work/net-deny.log"
: >"$CP_NET_DENY_LOG"
install_net_deny() {
  local name="$1"
  local src
  cat >"$net_block/$name" <<EOF
#!/bin/sh
printf '%s\n' "$name \$*" >> "\$CP_NET_DENY_LOG"
echo "テスト中に $name が呼ばれました。ネットワークへは出ません。" >&2
exit 99
EOF
  chmod +x "$net_block/$name"
  for src in "/usr/bin/$name" "/bin/$name"; do
    if [[ -x "$src" ]]; then
      ln -s "$src" "$net_behind/$name"
      break
    fi
  done
}
for name in curl wget python python3 oj; do
  install_net_deny "$name"
done
export PATH="$net_block:$PATH"

export CP_CONTEST_FETCH_CMD="$fetch"
export CP_CONTEST_OJ_CMD="$oj"
export CP_CONTEST_SLEEP=0
export CP_CONTEST_RETRIES=2
export CP_CONTEST_RETRY_WAIT=0
export CP_FETCH_LOG="$fetch_log"
export CP_OJ_LOG="$oj_log"

echo "== 全問題を作って A へ移動する =="
: >"$fetch_log"
: >"$oj_log"
(
  # shellcheck disable=SC1091
  . "$CP_PROJECT_ROOT/scripts/shell-functions.sh"
  abc 999
  [[ "$(pwd)" == "$CP_PROJECT_ROOT/work/abc999/a" ]]
) 2>"$work/abc999-first.err"
grep -qxF 'https://atcoder.jp/contests/abc999' "$work/abc999-first.err"
if grep -q '^https://atcoder.jp/contests/abc999/tasks/' "$work/abc999-first.err"; then
  echo "問題記号が無いのに問題 URL が出ました" >&2
  exit 1
fi
for folder in a b ex; do
  [[ -f "$CP_PROJECT_ROOT/work/abc999/$folder/a.cpp" ]]
  [[ ! -e "$CP_PROJECT_ROOT/work/abc999/$folder/a.py" ]]
  [[ -f "$CP_PROJECT_ROOT/work/abc999/$folder/test/sample-1.in" ]]
done
[[ "$(wc -l <"$oj_log" | tr -d ' ')" -eq 3 ]]

echo "== 再実行は上書きせず、取得済みは飛ばす =="
printf 'CUSTOM\n' >"$CP_PROJECT_ROOT/work/abc999/a/a.cpp"
before=$(wc -l <"$oj_log" | tr -d ' ')
(
  # shellcheck disable=SC1091
  . "$CP_PROJECT_ROOT/scripts/shell-functions.sh"
  abc 999
  [[ "$(pwd)" == "$CP_PROJECT_ROOT/work/abc999/a" ]]
) 2>"$work/abc999-again.err"
grep -qxF 'https://atcoder.jp/contests/abc999' "$work/abc999-again.err"
[[ "$(cat "$CP_PROJECT_ROOT/work/abc999/a/a.cpp")" == "CUSTOM" ]]
[[ "$(wc -l <"$oj_log" | tr -d ' ')" -eq "$before" ]]

echo "== 問題記号だけなら移動し、無ければその問題だけ用意する =="
(
  # shellcheck disable=SC1091
  . "$CP_PROJECT_ROOT/scripts/shell-functions.sh"
  abc 999 ex
  [[ "$(pwd)" == "$CP_PROJECT_ROOT/work/abc999/ex" ]]
) 2>"$work/abc999-ex.err"
grep -qxF 'https://atcoder.jp/contests/abc999' "$work/abc999-ex.err"
grep -qxF 'https://atcoder.jp/contests/abc999/tasks/abc999_h' "$work/abc999-ex.err"
[[ "$(wc -l <"$oj_log" | tr -d ' ')" -eq "$before" ]]
rm -rf "$CP_PROJECT_ROOT/work/abc999/b"
(
  # shellcheck disable=SC1091
  . "$CP_PROJECT_ROOT/scripts/shell-functions.sh"
  abc 999 b
  [[ "$(pwd)" == "$CP_PROJECT_ROOT/work/abc999/b" ]]
)
[[ -f "$CP_PROJECT_ROOT/work/abc999/b/a.cpp" ]]
[[ "$(wc -l <"$oj_log" | tr -d ' ')" -eq $((before + 1)) ]]

echo "== contest でも URL を出す =="
(
  # shellcheck disable=SC1091
  . "$CP_PROJECT_ROOT/scripts/shell-functions.sh"
  contest arc190
  [[ "$(pwd)" == "$CP_PROJECT_ROOT/work/arc190/a" ]]
) 2>"$work/arc190-first.err"
grep -qxF 'https://atcoder.jp/contests/arc190' "$work/arc190-first.err"
(
  # shellcheck disable=SC1091
  . "$CP_PROJECT_ROOT/scripts/shell-functions.sh"
  contest arc190
  [[ "$(pwd)" == "$CP_PROJECT_ROOT/work/arc190/a" ]]
) 2>"$work/arc190-again.err"
grep -qxF 'https://atcoder.jp/contests/arc190' "$work/arc190-again.err"

echo "== 問題一覧が取れない =="
export CP_CONTEST_FETCH_CMD="$fail_fetch"
: >"$fetch_log"
set +e
out=$("$CP_PROJECT_ROOT/scripts/prepare-contest" abc 998)
status=$?
set -e
[[ "$status" -eq 1 ]]
[[ -z "$out" ]]
[[ ! -d "$CP_PROJECT_ROOT/work/abc998" ]]
[[ "$(wc -l <"$fetch_log" | tr -d ' ')" -eq 2 ]]

export CP_CONTEST_FETCH_CMD="$fail_fetch"
: >"$fetch_log"
: >"$oj_log"
set +e
out=$("$CP_PROJECT_ROOT/scripts/prepare-contest" abc 998 e)
status=$?
set -e
[[ "$status" -eq 2 ]]
[[ "$out" == "$CP_PROJECT_ROOT/work/abc998/e" ]]
[[ "$out" != *INFO* ]]
[[ -f "$out/a.cpp" ]]
[[ -f "$out/test/sample-1.in" ]]

echo "== 一部のダウンロードに失敗しても移動先を返す =="
export CP_CONTEST_FETCH_CMD="$fetch"
oj_partial="$work/oj-partial"
cat >"$oj_partial" <<'EOF'
#!/bin/sh
echo "[INFO] online-judge-tools fake"
echo "[INFO] download $1"
printf '%s\n' "$1" >> "$CP_OJ_LOG"
case "$1" in
*_b) exit 1 ;;
esac
mkdir -p "$2/test"
printf '1\n' >"$2/test/sample-1.in"
printf '1\n' >"$2/test/sample-1.out"
EOF
chmod +x "$oj_partial"
export CP_CONTEST_OJ_CMD="$oj_partial"
: >"$oj_log"
set +e
out=$("$CP_PROJECT_ROOT/scripts/prepare-contest" abc 997)
status=$?
set -e
[[ "$status" -eq 2 ]]
[[ "$out" == "$CP_PROJECT_ROOT/work/abc997/a" ]]
[[ "$out" != *INFO* ]]
[[ -f "$CP_PROJECT_ROOT/work/abc997/a/test/sample-1.in" ]]
[[ -f "$CP_PROJECT_ROOT/work/abc997/b/a.cpp" ]]
[[ ! -f "$CP_PROJECT_ROOT/work/abc997/b/test/sample-1.in" ]]
rm -rf "$CP_PROJECT_ROOT/work/abc997"

echo "== oj の標準出力ログが移動先パスに混ざらない =="
export CP_CONTEST_FETCH_CMD="$fetch"
export CP_CONTEST_OJ_CMD="$oj"
out=$("$CP_PROJECT_ROOT/scripts/prepare-contest" abc 996)
[[ "$out" == "$CP_PROJECT_ROOT/work/abc996/a" ]]
[[ "$out" != *INFO* ]]
[[ "$(printf '%s\n' "$out" | wc -l | tr -d ' ')" -eq 1 ]]

echo "== エディタ起動側も同じパスを使う =="
# /usr/bin をそのまま PATH にすると、ホストの python3 が AtCoder へ接続する。
# zed が PATH にあると、移動先を表示する分岐にも入らない。
# 必要なコマンドだけ通し、curl 等は失敗スタブの後ろに本物を置く。
tool_bin="$work/tools"
mkdir -p "$tool_bin"
for name in env bash sh mktemp tail rm cp mkdir cat sleep chmod grep tr head ln ls uname dirname readlink; do
  for src in "/usr/bin/$name" "/bin/$name"; do
    if [[ -x "$src" ]]; then
      ln -s "$src" "$tool_bin/$name"
      break
    fi
  done
done
for name in bash mktemp cp mkdir rm cat tail tr; do
  if [[ ! -x "$tool_bin/$name" ]]; then
    echo "テストに $name が必要です" >&2
    exit 1
  fi
done
editor_path="$net_block:$net_behind:$tool_bin"
[[ "$(PATH="$editor_path" command -v curl)" == "$net_block/curl" ]]
[[ "$(PATH="$editor_path" command -v python3)" == "$net_block/python3" ]]
if [[ -e "$net_behind/curl" ]]; then
  behind=$(PATH="$editor_path" bash -c 'IFS=:; set -- $PATH; shift; PATH="$*"; command -v curl')
  [[ "$behind" == "$net_behind/curl" ]]
fi
[[ -z "$(PATH="$editor_path" command -v zed || true)" ]]
: >"$CP_NET_DENY_LOG"
status=0
msg=$(PATH="$editor_path" "$CP_PROJECT_ROOT/scripts/prepare-and-open" "995" 2>&1) || status=$?
[[ "$status" -eq 0 ]]
printf '%s\n' "$msg" | grep -F "$CP_PROJECT_ROOT/work/abc995/a/a.cpp" >/dev/null
printf '%s\n' "$msg" | grep -qxF 'https://atcoder.jp/contests/abc995'
[[ -f "$CP_PROJECT_ROOT/work/abc995/a/a.cpp" ]]
[[ "$(cat "$CP_PROJECT_ROOT/work/abc995/a/test/sample-1.in")" == "2 3" ]]
if [[ -s "$CP_NET_DENY_LOG" ]]; then
  echo "ネットワーク用コマンドが呼ばれました:" >&2
  cat "$CP_NET_DENY_LOG" >&2
  exit 1
fi
