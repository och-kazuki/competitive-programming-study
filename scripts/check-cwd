#!/usr/bin/env bash
# 問題ディレクトリで引数なしの just が、その場所を基準に動くことを確認する。
set -euo pipefail

# shellcheck disable=SC1091
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/require-dev-shell"

if [[ -z "${CP_PROJECT_ROOT:-}" ]]; then
  CP_PROJECT_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
fi
if ! command -v just >/dev/null 2>&1; then
  echo "just が見つかりません。nix develop 内で実行してください。" >&2
  exit 1
fi

name="cwdcheck"
dest="$CP_PROJECT_ROOT/work/$name/a"
rm -rf "$CP_PROJECT_ROOT/work/$name"
trap 'rm -rf "$CP_PROJECT_ROOT/work/$name"' EXIT

"$CP_PROJECT_ROOT/scripts/new-problem" "$name" a

cat >"$dest/a.cpp" <<'EOF'
#include "library/cpp/template.hpp"

int main() {
  long long a, b;
  cin >> a >> b;
  OUT(a + b);
  return 0;
}
EOF

cat >"$dest/a.py" <<'EOF'
def main() -> None:
    a, b = map(int, input().split())
    print(a + b)


if __name__ == "__main__":
    main()
EOF

printf '2 3\n' >"$dest/test/sample-1.in"
printf '5\n' >"$dest/test/sample-1.out"

echo "== 問題ディレクトリで引数なし =="
(
  cd "$dest"
  just oj-cpp
  just oj-py
  just submit-file
  cpp_out=$(printf '2 3\n' | just runcpp)
  py_out=$(printf '2 3\n' | just runpy)
  [[ "$cpp_out" == "5" ]]
  [[ "$py_out" == "5" ]]
  [[ -f submit.cpp ]]
  grep -q 'template <class T> inline bool chmin' submit.cpp
  if grep -q '#include "library/' submit.cpp; then
    echo "提出ファイルにローカル include が残っています" >&2
    exit 1
  fi
  printf -v expected_mode '%o' "$((0666 & ~8#$(umask)))"
  if actual_mode=$(stat -c '%a' submit.cpp 2>/dev/null); then
    :
  else
    actual_mode=$(stat -f '%OLp' submit.cpp)
  fi
  if [[ "$actual_mode" != "$expected_mode" ]]; then
    echo "submit.cpp の権限が $actual_mode です（umask からは $expected_mode）" >&2
    exit 1
  fi
)

echo "== 親ディレクトリからの相対パス =="
(
  cd "$CP_PROJECT_ROOT/work/$name"
  just oj-cpp a
  just submit-file a
)

echo "== リポジトリルートからの相対パス =="
(
  cd "$CP_PROJECT_ROOT"
  just oj-cpp "work/$name/a"
  printf '2 3\n' | just runcpp "work/$name/a/a.cpp" >/dev/null
)

echo "== 絶対パス =="
(
  cd /tmp
  just --justfile "$CP_PROJECT_ROOT/justfile" oj-cpp "$dest"
)

echo "== submit-file の失敗では submit.cpp を残さない =="
fail_dir=$(mktemp -d)
(
  if "$CP_PROJECT_ROOT/scripts/submit-file" "$fail_dir"; then
    echo "a.cpp が無いのに成功しました" >&2
    exit 1
  fi
  if [[ -e "$fail_dir/submit.cpp" ]]; then
    echo "空の submit.cpp が残っています" >&2
    exit 1
  fi
  printf '%s\n' '#include "library/cpp/no-such-header.hpp"' 'int main() { return 0; }' >"$fail_dir/a.cpp"
  if "$CP_PROJECT_ROOT/scripts/submit-file" "$fail_dir"; then
    echo "壊れた include なのに成功しました" >&2
    exit 1
  fi
  if [[ -e "$fail_dir/submit.cpp" || -n "$(find "$fail_dir" -name '.submit.*' -print -quit)" ]]; then
    echo "失敗後に一時ファイルか submit.cpp が残っています" >&2
    exit 1
  fi
)
rm -rf "$fail_dir"
