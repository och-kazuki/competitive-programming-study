#!/usr/bin/env bash
# 追跡しているサンプルで、問題ディレクトリと同じ手順の oj を確認する。
set -euo pipefail

# shellcheck disable=SC1091
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/require-dev-shell"

if [[ -z "${CP_PROJECT_ROOT:-}" ]]; then
  CP_PROJECT_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
fi

oj_cache=$("$CP_PROJECT_ROOT/scripts/seed-oj-cache")
trap 'rm -rf "$oj_cache"' EXIT
export XDG_CACHE_HOME="$oj_cache"

"$CP_PROJECT_ROOT/scripts/oj-test" cpp "$CP_PROJECT_ROOT/tests/oj"
"$CP_PROJECT_ROOT/scripts/oj-test" py "$CP_PROJECT_ROOT/tests/oj"
