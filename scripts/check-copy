#!/usr/bin/env bash
# 偽物のクリップボードコマンドで、展開結果の受け渡しと失敗時の非更新を確認する。
set -euo pipefail

# shellcheck disable=SC1091
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/require-dev-shell"

if [[ -z "${CP_PROJECT_ROOT:-}" ]]; then
  CP_PROJECT_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

fake="$work/fake-clipboard"
sink="$work/clipboard.txt"
cat >"$fake" <<'EOF'
#!/bin/sh
cat > "$CP_CLIP_SINK"
EOF
chmod +x "$fake"
export CP_CLIPBOARD_CMD="$fake"
export CP_CLIP_SINK="$sink"

echo "== 展開したコードがクリップボードへ渡る =="
printf 'BEFORE\n' >"$sink"
out=$("$CP_PROJECT_ROOT/scripts/copy-submit" "$CP_PROJECT_ROOT/templates/a.cpp")
printf '%s\n' "$out" | grep -q '^コピーしました（'
expected=$("$CP_PROJECT_ROOT/scripts/bundle_cpp.py" -I "$CP_PROJECT_ROOT" "$CP_PROJECT_ROOT/templates/a.cpp")
got=$(cat "$sink")
if [[ "$got" != "$expected" ]]; then
  echo "クリップボードへ渡した内容が展開結果と違います" >&2
  exit 1
fi

echo "== フォルダを指定しても a.cpp をコピーする =="
mkdir -p "$work/prob"
cp "$CP_PROJECT_ROOT/templates/a.cpp" "$work/prob/a.cpp"
printf 'BEFORE\n' >"$sink"
(
  cd "$work/prob"
  just --justfile "$CP_PROJECT_ROOT/justfile" copy
) >/dev/null
got=$(cat "$sink")
if [[ "$got" != "$expected" ]]; then
  echo "just copy の結果が展開結果と違います" >&2
  exit 1
fi

echo "== コンパイル失敗時はクリップボードを変えない =="
printf 'UNCHANGED\n' >"$sink"
bad="$work/bad.cpp"
printf '%s\n' 'int main() { this is not valid c++' >"$bad"
if "$CP_PROJECT_ROOT/scripts/copy-submit" "$bad"; then
  echo "壊れたソースなのに成功しました" >&2
  exit 1
fi
got=$(cat "$sink")
if [[ "$got" != "UNCHANGED" ]]; then
  echo "コンパイル失敗なのにクリップボードが変わりました: $got" >&2
  exit 1
fi

echo "== 子プロセスが残ってもパイプが終わる =="
linger_bin="$work/bin"
mkdir -p "$linger_bin"
pidfile="$work/linger.pid"
cat >"$linger_bin/xclip" <<'EOF'
#!/bin/sh
cat > "$CP_CLIP_SINK"
# stdout/stderr を握ったまま残る。親が切り離していないとパイプが閉じない。
(sleep 60) &
echo $! > "$CP_CLIP_PID"
EOF
chmod +x "$linger_bin/xclip"
printf 'BEFORE\n' >"$sink"
if ! linger_out=$(
  timeout 5 env \
    -u CP_CLIPBOARD_CMD \
    -u WAYLAND_DISPLAY \
    -u WSL_DISTRO_NAME \
    -u WSL_INTEROP \
    DISPLAY=:0 \
    PATH="$linger_bin:$PATH" \
    CP_CLIP_SINK="$sink" \
    CP_CLIP_PID="$pidfile" \
    bash -c '"$1" "$2" 2>&1 | tail' _ \
    "$CP_PROJECT_ROOT/scripts/copy-submit" \
    "$CP_PROJECT_ROOT/templates/a.cpp"
); then
  echo "パイプが5秒以内に終わりませんでした" >&2
  exit 1
fi
if [[ -f "$pidfile" ]]; then
  kill "$(cat "$pidfile")" 2>/dev/null || true
  wait "$(cat "$pidfile")" 2>/dev/null || true
fi
printf '%s\n' "$linger_out" | grep -q 'コピーしました（'
linger_got=$(cat "$sink")
if [[ "$linger_got" != "$expected" ]]; then
  echo "残存する子プロセスのテストで、渡した内容が違います" >&2
  exit 1
fi
