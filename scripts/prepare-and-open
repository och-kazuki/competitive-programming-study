#!/usr/bin/env bash
# コンテストを用意し、Zed で解答ファイルを開く。
set -euo pipefail

# shellcheck disable=SC1091
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/require-dev-shell"

root="${CP_PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
spec="${1:-}"
if [[ -z "$spec" ]]; then
  echo "コンテストを指定してください。例: 400 または 400 e または arc190" >&2
  exit 1
fi

read -r -a parts <<<"$spec"
if [[ "${parts[0]}" =~ ^[0-9]+$ ]]; then
  args=(abc "${parts[@]}")
else
  args=("${parts[@]}")
fi

status=0
dest_file="$(mktemp)"
CP_CONTEST_DEST_FILE="$dest_file" "$root/scripts/prepare-contest" "${args[@]}" || status=$?
dest="$(tail -n 1 "$dest_file" 2>/dev/null | tr -d '\r' || true)"
rm -f "$dest_file"
if [[ -z "$dest" || ! -f "$dest/a.cpp" ]]; then
  exit "$status"
fi

if command -v zed >/dev/null 2>&1; then
  zed "$dest/a.cpp" || true
else
  echo "zed がないため、ファイルは開きません: $dest/a.cpp" >&2
fi
exit "$status"
