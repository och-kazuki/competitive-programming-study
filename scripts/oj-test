#!/usr/bin/env bash
# 問題ディレクトリの test/ で a.cpp を oj で実行する。
set -euo pipefail

# shellcheck disable=SC1091
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/require-dev-shell"

if [[ $# -gt 1 ]]; then
  echo "使い方: oj-test [ディレクトリ]" >&2
  exit 1
fi

dir="${1:-.}"

root="${CP_PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
dir=$(cd "$dir" && pwd)

if [[ ! -d "$dir/test" ]]; then
  echo "test/ がありません: $dir" >&2
  echo "サンプルを置くか、問題ディレクトリで oj d <問題URL> を実行してください。" >&2
  exit 1
fi
if ! command -v oj >/dev/null 2>&1; then
  echo "oj が見つかりません。nix develop 内で実行してください。" >&2
  exit 1
fi

if [[ ! -f "$dir/a.cpp" ]]; then
  echo "a.cpp がありません: $dir" >&2
  exit 1
fi
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
mode="${CP_CXX_MODE:-debug}"
echo "ビルド: $mode" >&2
CP_CXX_MODE="$mode" bash "$root/scripts/cp-gxx" -o "$tmp" "$dir/a.cpp"
oj t -c "$tmp" -d "$dir/test"
