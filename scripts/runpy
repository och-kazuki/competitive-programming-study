#!/usr/bin/env bash
# Python を実行する。
# 引数の先頭がファイルならそれを、なければカレントの a.py、それも無ければテンプレートを使う。
set -euo pipefail

# shellcheck disable=SC1091
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/require-dev-shell"

root="${CP_PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
export PYTHONPATH="$root/library/python${PYTHONPATH:+:$PYTHONPATH}"
args=("$@")
src=""

if [[ ${#args[@]} -gt 0 && -f "${args[0]}" ]]; then
  src="${args[0]}"
  if [[ ${#args[@]} -gt 1 ]]; then
    args=("${args[@]:1}")
  else
    args=()
  fi
elif [[ -f a.py ]]; then
  src="a.py"
else
  src="$root/templates/a.py"
fi

if [[ "$src" != /* ]]; then
  src="$PWD/$src"
fi

python3="$root/.venv/bin/python"
if [[ ! -x "$python3" ]]; then
  if command -v python3 >/dev/null 2>&1; then
    python3=$(command -v python3)
  else
    echo "python3 が見つかりません。nix develop 内で実行してください。" >&2
    exit 1
  fi
fi

if [[ ${#args[@]} -eq 0 ]]; then
  exec "$python3" "$src"
else
  exec "$python3" "$src" "${args[@]}"
fi
