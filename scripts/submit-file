#!/usr/bin/env bash
# 問題ディレクトリの a.cpp を展開し、同じディレクトリへ submit.cpp を書く。
set -euo pipefail

root="${CP_PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
dir="${1:-.}"
dir=$(cd "$dir" && pwd)

if [[ ! -f "$dir/a.cpp" ]]; then
  echo "a.cpp がありません: $dir" >&2
  exit 1
fi

tmp=$(mktemp "$dir/.submit.XXXXXX")
cleanup() {
  rm -f "$tmp"
}
trap cleanup EXIT

python3 "$root/scripts/bundle_cpp.py" -I "$root" "$dir/a.cpp" >"$tmp"
# mktemp は 600 で作る。通常の新規ファイルと同じく umask に従わせる。
printf -v perm '%o' "$((0666 & ~8#$(umask)))"
chmod "$perm" "$tmp"
mv "$tmp" "$dir/submit.cpp"
trap - EXIT
echo "$dir/submit.cpp"
