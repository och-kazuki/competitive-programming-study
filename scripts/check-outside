#!/usr/bin/env bash
# devShell の外ではスクリプトと just が止まることを確認する。
set -euo pipefail

# shellcheck disable=SC1091
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/require-dev-shell"

if [[ -z "${CP_PROJECT_ROOT:-}" ]]; then
  CP_PROJECT_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
fi

err="$(mktemp)"
trap 'rm -f "$err"' EXIT

echo "== devShell の外では run が止まる =="
set +e
env -u CP_IN_DEV_SHELL "$CP_PROJECT_ROOT/scripts/run" >/dev/null 2>"$err"
status=$?
set -e
[[ "$status" -ne 0 ]]
grep -q "先に nix develop を実行してください。" "$err"

echo "== devShell の外では just も止まる =="
set +e
env -u CP_IN_DEV_SHELL just --justfile "$CP_PROJECT_ROOT/justfile" run >/dev/null 2>"$err"
status=$?
set -e
[[ "$status" -ne 0 ]]
grep -q "先に nix develop を実行してください。" "$err"

echo "== devShell の外では just bundle も止まる =="
set +e
env -u CP_IN_DEV_SHELL just --justfile "$CP_PROJECT_ROOT/justfile" bundle "$CP_PROJECT_ROOT/templates/a.cpp" >/dev/null 2>"$err"
status=$?
set -e
[[ "$status" -ne 0 ]]
grep -q "先に nix develop を実行してください。" "$err"

echo "== 外から source しても関数は定義しない =="
set +e
env -u CP_IN_DEV_SHELL bash -c 'set -e; . "$1"' _ "$CP_PROJECT_ROOT/scripts/shell-functions.sh" >/dev/null 2>"$err"
status=$?
set -e
[[ "$status" -ne 0 ]]
grep -q "先に nix develop を実行してください。" "$err"
