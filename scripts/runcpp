#!/usr/bin/env bash
# C++ をコンパイルして実行する。
# 引数の先頭がファイルならそれを、なければカレントの a.cpp、それも無ければテンプレートを使う。
set -euo pipefail

# shellcheck disable=SC1091
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/require-dev-shell"

root="${CP_PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
args=("$@")
src=""

if [[ ${#args[@]} -gt 0 && -f "${args[0]}" ]]; then
  src="${args[0]}"
  if [[ ${#args[@]} -gt 1 ]]; then
    args=("${args[@]:1}")
  else
    args=()
  fi
elif [[ -f a.cpp ]]; then
  src="a.cpp"
else
  src="$root/templates/a.cpp"
fi

if [[ "$src" != /* ]]; then
  src="$PWD/$src"
fi

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
bash "$root/scripts/cp-gxx" -o "$tmp" "$src"
if [[ ${#args[@]} -eq 0 ]]; then
  "$tmp"
else
  "$tmp" "${args[@]}"
fi
