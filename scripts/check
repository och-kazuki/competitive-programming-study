#!/usr/bin/env bash
# テンプレートのコンパイル、ライブラリテスト、ruff を実行する。
set -euo pipefail

# shellcheck disable=SC1091
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/require-dev-shell"

if [[ -z "${CP_PROJECT_ROOT:-}" ]]; then
  CP_PROJECT_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
fi
if [[ -z "${AC_LIBRARY_INCLUDE:-}" ]]; then
  echo "AC_LIBRARY_INCLUDE が未設定です。nix develop 内で実行してください。" >&2
  exit 1
fi

cxx="$CP_PROJECT_ROOT/scripts/cp-gxx"
tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

echo "== C++ テンプレート =="
bash "$cxx" -o "$tmpdir/template" "$CP_PROJECT_ROOT/templates/a.cpp"
"$tmpdir/template"

echo "== C++ テンプレート詳細 =="
bash "$CP_PROJECT_ROOT/scripts/check-template"

echo "== ライブラリ README の使用例 =="
bash "$CP_PROJECT_ROOT/scripts/check-library-readme"

echo "== C++ ライブラリテスト =="
shopt -s nullglob
tests=("$CP_PROJECT_ROOT"/tests/cpp/*.cpp)
if [[ ${#tests[@]} -eq 0 ]]; then
  echo "テストファイルはありません"
else
  for src in "${tests[@]}"; do
    name=$(basename "$src" .cpp)
    echo "-- $name"
    bash "$cxx" -Werror -o "$tmpdir/$name" "$src"
    "$tmpdir/$name"
  done
fi

echo "== C++ 展開 =="
bundled="$tmpdir/bundled.cpp"
python3 "$CP_PROJECT_ROOT/scripts/bundle_cpp.py" -I "$CP_PROJECT_ROOT" \
  "$CP_PROJECT_ROOT/templates/a.cpp" >"$bundled"
python3 - "$bundled" <<'PY'
import sys

text = open(sys.argv[1], encoding="utf-8").read()
if '#include "library/' in text:
    sys.exit("ローカル include が残っています")
if "using vi = vector<ll>;" not in text:
    sys.exit("テンプレートヘッダが展開されていません")
if "int main()" not in text:
    sys.exit("main がありません")
needle = "// Repository: https://github.com/och-kazuki/competitive-programming-study"
count = sum(1 for line in text.splitlines() if line == needle)
if count != 1:
    sys.exit(f"出典コメント（Repository）が{count}回です")
PY
# 展開後はリポジトリをインクルードパスに入れなくてもコンパイルできる。
g++ -std=gnu++20 -O2 -Wall -Wextra -o "$tmpdir/bundled" "$bundled"
"$tmpdir/bundled"

lib_src="$tmpdir/with-lib.cpp"
cat >"$lib_src" <<'EOF'
#include "library/cpp/graph/dijkstra/dijkstra.hpp"
#include "library/cpp/math/binomial/binomial.hpp"
int main() { return 0; }
EOF
lib_bundled="$tmpdir/with-lib-bundled.cpp"
python3 "$CP_PROJECT_ROOT/scripts/bundle_cpp.py" -I "$CP_PROJECT_ROOT" "$lib_src" >"$lib_bundled"
python3 - "$lib_bundled" <<'PY'
import sys

text = open(sys.argv[1], encoding="utf-8").read()
if '#include "library/' in text:
    sys.exit("ライブラリの展開後にローカル include が残っています")
if "#include <atcoder/modint.hpp>" not in text:
    sys.exit("AtCoder Library の include が展開されています")
needle = "// Repository: https://github.com/och-kazuki/competitive-programming-study"
count = sum(1 for line in text.splitlines() if line == needle)
if count != 1:
    sys.exit(f"出典コメント（Repository）が{count}回です")
PY
g++ -std=gnu++20 -O2 -Wall -Wextra -isystem "$AC_LIBRARY_INCLUDE" -o "$tmpdir/with-lib" "$lib_bundled"

echo "== 再 include は空のマーカーを出さない =="
cumsum_src="$tmpdir/with-cumsum.cpp"
cat >"$cumsum_src" <<'EOF'
#include "library/cpp/template.hpp"
#include "library/cpp/range/cumsum/cumsum.hpp"
int main() {
  vc<ll> a{1, 2, 3};
  vc<ll> s = cumsum<ll>(a);
  return s.size() == 4 && s[3] == 6 ? 0 : 1;
}
EOF
cumsum_bundled="$tmpdir/with-cumsum-bundled.cpp"
python3 "$CP_PROJECT_ROOT/scripts/bundle_cpp.py" -I "$CP_PROJECT_ROOT" "$cumsum_src" >"$cumsum_bundled"
python3 - "$cumsum_bundled" <<'PY'
import sys

text = open(sys.argv[1], encoding="utf-8").read()
lines = text.splitlines()
if '#include "library/' in text:
    sys.exit("cumsum の展開後にローカル include が残っています")
needle = "// Repository: https://github.com/och-kazuki/competitive-programming-study"
count = sum(1 for line in lines if line == needle)
if count != 1:
    sys.exit(f"出典コメント（Repository）が{count}回です")
begin = "// begin library/cpp/template.hpp"
if sum(1 for line in lines if line == begin) != 1:
    sys.exit("template.hpp の begin が1回ではありません")
for prev, nxt in zip(lines, lines[1:]):
    if prev.startswith("// begin ") and nxt == "// end " + prev.removeprefix("// begin "):
        sys.exit(f"空の begin/end があります: {prev}")
if "vc<T> cumsum" not in text:
    sys.exit("cumsum の定義が展開されていません")
PY
g++ -std=gnu++20 -O2 -Wall -Wextra -Werror -o "$tmpdir/with-cumsum" "$cumsum_bundled"
"$tmpdir/with-cumsum"

echo "== デバッグビルド =="
bash "$CP_PROJECT_ROOT/scripts/check-debug"

echo "== ストレステスト =="
bash "$CP_PROJECT_ROOT/scripts/check-stress"

echo "== Zed の設定 =="
bash "$CP_PROJECT_ROOT/scripts/check-zed"

echo "== Zed のスニペット =="
bash "$CP_PROJECT_ROOT/scripts/check-snippets"

echo "== ruff =="
export RUFF_CACHE_DIR="$tmpdir/ruff-cache"
ruff check \
  "$CP_PROJECT_ROOT/templates" \
  "$CP_PROJECT_ROOT/tests" \
  "$CP_PROJECT_ROOT/scripts/bundle_cpp.py" \
  "$CP_PROJECT_ROOT/scripts/fetch-atcoder-tasks.py"
ruff format --check \
  "$CP_PROJECT_ROOT/templates" \
  "$CP_PROJECT_ROOT/tests" \
  "$CP_PROJECT_ROOT/scripts/bundle_cpp.py" \
  "$CP_PROJECT_ROOT/scripts/fetch-atcoder-tasks.py"
