#!/usr/bin/env bash
# テンプレートのコンパイル、ライブラリテスト、ruff を実行する。
set -euo pipefail

# shellcheck disable=SC1091
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/require-dev-shell"

if [[ -z "${CP_PROJECT_ROOT:-}" ]]; then
  CP_PROJECT_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
fi
if [[ -z "${AC_LIBRARY_INCLUDE:-}" ]]; then
  echo "AC_LIBRARY_INCLUDE が未設定です。nix develop 内で実行してください。" >&2
  exit 1
fi

cxx="$CP_PROJECT_ROOT/scripts/cp-gxx"
tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

echo "== C++ テンプレート =="
bash "$cxx" -o "$tmpdir/template" "$CP_PROJECT_ROOT/templates/a.cpp"
"$tmpdir/template"

echo "== C++ テンプレート詳細 =="
bash "$CP_PROJECT_ROOT/scripts/check-template"

echo "== C++ ライブラリテスト =="
shopt -s nullglob
tests=("$CP_PROJECT_ROOT"/tests/cpp/*.cpp)
if [[ ${#tests[@]} -eq 0 ]]; then
  echo "テストファイルはありません"
else
  for src in "${tests[@]}"; do
    name=$(basename "$src" .cpp)
    echo "-- $name"
    bash "$cxx" -Werror -o "$tmpdir/$name" "$src"
    "$tmpdir/$name"
  done
fi

echo "== Python ライブラリテスト =="
export PYTHONPATH="$CP_PROJECT_ROOT/library/python${PYTHONPATH:+:$PYTHONPATH}"
pytests=("$CP_PROJECT_ROOT"/tests/python/test_*.py)
if [[ ${#pytests[@]} -eq 0 ]]; then
  echo "テストファイルはありません"
else
  python3 -m unittest discover -s "$CP_PROJECT_ROOT/tests/python" -v
fi

echo "== C++ 展開 =="
bundled="$tmpdir/bundled.cpp"
python3 "$CP_PROJECT_ROOT/scripts/bundle_cpp.py" -I "$CP_PROJECT_ROOT" \
  "$CP_PROJECT_ROOT/templates/a.cpp" >"$bundled"
python3 - "$bundled" <<'PY'
import sys

text = open(sys.argv[1], encoding="utf-8").read()
if '#include "library/' in text:
    sys.exit("ローカル include が残っています")
if "using vi = vector<ll>;" not in text:
    sys.exit("テンプレートヘッダが展開されていません")
if "int main()" not in text:
    sys.exit("main がありません")
if "// Repository: https://github.com/och-kazuki/competitive-programming-study" not in text:
    sys.exit("出典コメント（Repository）が残っていません")
PY
# 展開後はリポジトリをインクルードパスに入れなくてもコンパイルできる。
g++ -std=gnu++20 -O2 -Wall -Wextra -o "$tmpdir/bundled" "$bundled"
"$tmpdir/bundled"

echo "== デバッグビルド =="
bash "$CP_PROJECT_ROOT/scripts/check-debug"

echo "== ストレステスト =="
bash "$CP_PROJECT_ROOT/scripts/check-stress"

echo "== Zed の設定 =="
bash "$CP_PROJECT_ROOT/scripts/check-zed"

echo "== Zed のスニペット =="
bash "$CP_PROJECT_ROOT/scripts/check-snippets"

echo "== ruff =="
export RUFF_CACHE_DIR="$tmpdir/ruff-cache"
ruff check \
  "$CP_PROJECT_ROOT/templates" \
  "$CP_PROJECT_ROOT/library/python" \
  "$CP_PROJECT_ROOT/tests" \
  "$CP_PROJECT_ROOT/scripts/bundle_cpp.py" \
  "$CP_PROJECT_ROOT/scripts/fetch-atcoder-tasks.py"
ruff format --check \
  "$CP_PROJECT_ROOT/templates" \
  "$CP_PROJECT_ROOT/library/python" \
  "$CP_PROJECT_ROOT/tests" \
  "$CP_PROJECT_ROOT/scripts/bundle_cpp.py" \
  "$CP_PROJECT_ROOT/scripts/fetch-atcoder-tasks.py"
