{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.languageServer": "None",
  "python.terminal.activateEnvironment": true,
  "python-envs.defaultEnvManager": "ms-python.python:venv",
  "python-envs.pythonProjects": [
    {
      "path": ".",
      "envManager": "ms-python.python:venv"
    }
  ],
  "python.analysis.extraPaths": ["${workspaceFolder}/library/python"],
  "pyright.disableLanguageServices": false,
  "ruff.enable": true,
  "ruff.nativeServer": true,
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "editor.formatOnSave": false,
  "files.eol": "\n",
  "[python]": {
    "editor.tabSize": 4,
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "[cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  },
  "clangd.path": "${workspaceFolder}/scripts/editor-clangd",
  "clangd.checkUpdates": false,
  "clangd.arguments": [
    "--background-index",
    "--header-insertion=never",
    "--query-driver=**/g++"
  ],
  "C_Cpp.intelliSenseEngine": "disabled",
  "terminal.integrated.profiles.linux": {
    "nix develop": {
      "path": "nix",
      "args": ["develop", "${workspaceFolder}"]
    }
  },
  "terminal.integrated.profiles.osx": {
    "nix develop": {
      "path": "nix",
      "args": ["develop", "${workspaceFolder}"]
    }
  },
  "terminal.integrated.defaultProfile.linux": "nix develop",
  "terminal.integrated.defaultProfile.osx": "nix develop",
  "search.exclude": {
    "**/.venv": true,
    "**/work": true
  },
  "files.watcherExclude": {
    "**/.venv/**": true
  }
}
