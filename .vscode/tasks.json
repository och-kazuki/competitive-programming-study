{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C++: 開いているファイルを実行",
      "type": "shell",
      "command": "nix",
      "args": ["develop", "${workspaceFolder}", "-c", "runcpp", "${file}"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Python: 開いているファイルを実行",
      "type": "shell",
      "command": "nix",
      "args": ["develop", "${workspaceFolder}", "-c", "runpy", "${file}"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "C++: このフォルダの a.cpp を実行",
      "type": "shell",
      "command": "nix",
      "args": ["develop", "${workspaceFolder}", "-c", "runcpp", "${fileDirname}/a.cpp"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Python: このフォルダの a.py を実行",
      "type": "shell",
      "command": "nix",
      "args": ["develop", "${workspaceFolder}", "-c", "runpy", "${fileDirname}/a.py"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "oj: サンプルテスト (C++)",
      "type": "shell",
      "command": "nix",
      "args": ["develop", "${workspaceFolder}", "-c", "just", "oj-cpp", "${fileDirname}"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "oj: サンプルテスト (C++ 通常ビルド)",
      "type": "shell",
      "command": "nix",
      "args": ["develop", "${workspaceFolder}", "-c", "just", "oj-cpp-release", "${fileDirname}"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "C++: 開いているファイルを通常ビルドで実行",
      "type": "shell",
      "command": "nix",
      "args": ["develop", "${workspaceFolder}", "-c", "just", "runcpp-release", "${file}"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "oj: サンプルテスト (Python)",
      "type": "shell",
      "command": "nix",
      "args": ["develop", "${workspaceFolder}", "-c", "just", "oj-py", "${fileDirname}"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "コンテストを準備",
      "type": "shell",
      "command": "nix",
      "args": [
        "develop",
        "${workspaceFolder}",
        "-c",
        "bash",
        "${workspaceFolder}/scripts/prepare-and-open",
        "${input:contestSpec}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "C++: 提出用コードをコピー",
      "type": "shell",
      "command": "nix",
      "args": ["develop", "${workspaceFolder}", "-c", "just", "copy", "${file}"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "C++: 提出用ファイルを作る",
      "type": "shell",
      "command": "nix",
      "args": ["develop", "${workspaceFolder}", "-c", "just", "submit-file", "${fileDirname}"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "環境ファイルを更新",
      "type": "shell",
      "command": "nix",
      "args": ["develop", "${workspaceFolder}", "-c", "just", "sync"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "チェック",
      "type": "shell",
      "command": "nix",
      "args": ["develop", "${workspaceFolder}", "-c", "just", "check"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "contestSpec",
      "type": "promptString",
      "description": "コンテスト（例: 400、400 e、arc190）"
    }
  ]
}
