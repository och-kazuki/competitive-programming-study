{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C++: 開いているファイルを実行",
      "type": "shell",
      "command": "runcpp",
      "args": ["${file}"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Python: 開いているファイルを実行",
      "type": "shell",
      "command": "runpy",
      "args": ["${file}"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "C++: このフォルダの a.cpp を実行",
      "type": "shell",
      "command": "runcpp",
      "args": ["${fileDirname}/a.cpp"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Python: このフォルダの a.py を実行",
      "type": "shell",
      "command": "runpy",
      "args": ["${fileDirname}/a.py"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "oj: サンプルテスト (C++)",
      "type": "shell",
      "command": "just",
      "args": ["oj-cpp", "${fileDirname}"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "oj: サンプルテスト (Python)",
      "type": "shell",
      "command": "just",
      "args": ["oj-py", "${fileDirname}"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "oj: サンプルを取得",
      "type": "shell",
      "command": "oj",
      "args": ["d", "${input:problemUrl}"],
      "options": {
        "cwd": "${fileDirname}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "C++: 提出用コードをコピー",
      "type": "shell",
      "command": "just",
      "args": ["copy", "${file}"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "C++: 提出用ファイルを作る",
      "type": "shell",
      "command": "just",
      "args": ["submit-file", "${fileDirname}"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "問題ファイルを作成",
      "type": "shell",
      "command": "just",
      "args": ["new", "${input:contest}", "${input:problem}"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "環境ファイルを更新",
      "type": "shell",
      "command": "just",
      "args": ["sync"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "チェック",
      "type": "shell",
      "command": "just",
      "args": ["check"],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "contest",
      "type": "promptString",
      "description": "コンテスト名（例: abc400）"
    },
    {
      "id": "problem",
      "type": "promptString",
      "description": "問題名（例: a）"
    },
    {
      "id": "problemUrl",
      "type": "promptString",
      "description": "問題のURL"
    }
  ]
}
